{
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "import": "./src/router/index.ts",
      "default": "./src/router/index.ts"
    }
  },
  "scripts": {
    "postinstall": "chmod +x node_modules/nestjs-trpc/native/*/nestjs-trpc* 2>/dev/null || true",
    "dev": "node --watch --import @swc-node/register/esm-register --env-file=.env src/main.ts",
    "build": "pnpm trpc:generate && nest build",
    "start": "node --import @swc-node/register/esm-register --env-file=.env src/main.ts",
    "trpc:generate": "nestjs-trpc generate -o src/router/generated",
    "lint": "eslint .",
    "type": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/types": "workspace:*",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@trpc/server": "^11.16.0",
    "better-sqlite3": "^12.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "nestjs-trpc": "^2.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.27",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "prisma": "^7.8.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
