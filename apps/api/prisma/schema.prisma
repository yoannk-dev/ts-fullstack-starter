generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Todo {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      Status    @default(TODO)
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])
  authorId    Int

  @@index([authorId])
  @@index([status])
  @@map("todos")
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  todos Todo[]

  @@map("users")
}
